# claude-gateway configuration. Copy to .env and edit. All keys are read by
# GatewaySettings (env prefix CLAUDE_GATEWAY_, see gateway/shared/config.py).
#
#   cp .env.example .env
#   # set CLAUDE_GATEWAY_ADMIN_TOKEN, then: scripts/run.sh  (or  make run)
#
# Defaults below boot the server in `memory` mode with no further edits - only
# ADMIN_TOKEN is mandatory. For production set DB=postgres + DATABASE_URL.

# --- Server frontend ---
CLAUDE_GATEWAY_SERVER=fastapi          # fastapi | litestar | aiohttp
CLAUDE_GATEWAY_HOST=0.0.0.0
CLAUDE_GATEWAY_PORT=8081

# --- Data layer ---
# memory = in-process stores (dev/tests, state lost on restart).
# postgres = persistent; requires DATABASE_URL below.
CLAUDE_GATEWAY_DB=memory
# CLAUDE_GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# --- Control-surface secret (REQUIRED - server refuses to start if unset) ---
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAUDE_GATEWAY_ADMIN_TOKEN=

# --- Model mapping ---
CLAUDE_GATEWAY_DEFAULT_MODEL=claude-sonnet-4-6
# JSON object merged over the built-in aliases:
# CLAUDE_GATEWAY_MODEL_ALIASES={"gpt-4o":"claude-sonnet-4-6"}

# --- Limits / crypto ---
CLAUDE_GATEWAY_RATE_LIMIT_PER_MIN=120
# Fernet-style key to encrypt stored account cookies at rest (optional):
# CLAUDE_GATEWAY_COOKIE_ENCRYPTION_KEY=
